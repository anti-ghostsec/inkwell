<?xml version="1.0" encoding="utf-8"?>
<!-- No internet. Inkwell sees the files you hand it (Android's file picker,
     or "Open with" in another app), and folders you add; the photos
     permission only once you ask to swipe through the rest of a folder a
     picture was opened from. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14 on: "Select photos" (only some) works too. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 9 and older: deleting, and saving an edit next to the original. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <application
        android:label="Inkwell"
        android:icon="@mipmap/icon"
        android:roundIcon="@mipmap/icon"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:largeHeap="true"
        android:theme="@style/Inkwell">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:theme="@style/Inkwell.Viewer"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <!-- "Open with" from file managers, galleries and other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- Comics a file manager doesn't know the type of: by name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.CBZ" />
            </intent-filter>
            <!-- Share a picture to Inkwell. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
            </intent-filter>
        </activity>
        <!-- Pictures handed to other apps (Share, Open with, Set as wallpaper):
             copies in Inkwell's cache, readable only by the app given each. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="io.github.inkwell.viewer.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
